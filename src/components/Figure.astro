---
// Inline photography for MDX prose — the same framed-image treatment used
// for the plate and (formerly) the end-of-page gallery, sized to sit inside
// prose next to the paragraph it illustrates rather than in a separate block
// of its own.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /**
   * Aspect ratio to crop to, e.g. "4/3". Set it for photos gridded into a row:
   * a shared shape is what makes them read as one glance at the room, and a
   * grid of native aspect ratios reads as a stack of unrelated slabs instead.
   */
  crop?: string;
  /** Override when the figure is gridded and no longer a full prose column. */
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  crop,
  sizes = "(min-width: 768px) 640px, 92vw",
} = Astro.props;
---

<figure class="block-figure border border-white/10 bg-white/[0.02] p-2">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1100]}
    sizes={sizes}
    class={crop ? "w-full object-cover" : "h-auto w-full"}
    style={crop ? `aspect-ratio: ${crop}` : undefined}
  />
  {
    caption && (
      <figcaption class="mt-2 px-1 pb-1 text-xs leading-relaxed text-white/55">
        {caption}
      </figcaption>
    )
  }
</figure>
