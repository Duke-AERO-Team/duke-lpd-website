---
interface Props {
  reverse?: boolean;
}
const { reverse = false } = Astro.props;
---

<section
  class:list={["subteam-feature", { "subteam-feature-reverse": reverse }]}
>
  <div class="feature-copy"><slot /></div>
  <div class="feature-media"><slot name="media" /></div>
</section>

<style>
  .subteam-feature {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  .subteam-feature + .subteam-feature {
    margin-top: 4rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    padding-top: 4rem;
  }

  .feature-copy,
  .feature-media {
    min-width: 0;
  }

  .feature-copy :global(h2) {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .feature-copy :global(p) {
    margin-top: 1.5rem;
    max-width: 38rem;
    text-wrap: pretty;
  }

  .feature-media :global(.block-figure) {
    padding: 0;
    border: 0;
    background: none;
  }

  .feature-media :global(.photo-note),
  .feature-media :global(figcaption) {
    margin-top: 0.75rem;
    padding: 0;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .feature-media :global(.feature-gallery) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .feature-media :global(.feature-gallery > :first-child) {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .subteam-feature {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
    }

    .subteam-feature + .subteam-feature {
      margin-top: 5rem;
      padding-top: 5rem;
    }

    .subteam-feature-reverse {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .subteam-feature-reverse .feature-copy {
      grid-column: 2;
      grid-row: 1;
    }

    .subteam-feature-reverse .feature-media {
      grid-column: 1;
      grid-row: 1;
    }

    .feature-media :global(.feature-gallery-hardware) {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .feature-media :global(.feature-gallery-hardware > :first-child) {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .feature-media :global(.feature-gallery-hardware > :first-child img) {
      height: 100%;
      aspect-ratio: auto !important;
      object-fit: cover;
    }
  }
</style>
