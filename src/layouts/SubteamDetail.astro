---
import { Image } from "astro:assets";
import { ArrowLeft } from "@lucide/astro";
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Embers from "../components/Embers.astro";
import { subteams } from "../data/subteams";

// MDX layout frontmatter, not page props — same contract as ProjectDetail:
// the page carries only `slug`, and everything drawn below (name, detail,
// plate, specs) is looked up from `data/subteams.ts` so a subteam page never
// forks a second copy of facts the About cards already own.
//
// Deliberately no roster here: a subteam page describes the work, and naming
// people is `/team`'s job. `subteams.ts` still carries `members`, because that
// is where /team reads the rows and their lead from.
interface Props {
  frontmatter: { slug: string };
}

const {
  frontmatter: { slug },
} = Astro.props;

const team = subteams.find((t) => t.slug === slug);
if (!team) {
  throw new Error(
    `SubteamDetail: no subteam in data/subteams.ts with slug "${slug}"`,
  );
}

// Rendered up front so an empty MDX body leaves no trace: a subteam with no
// write-up yet has to produce exactly the page it produced when these were one
// generated route, not a stray rule with 4rem of padding under it.
const prose = Astro.slots.has("default")
  ? (await Astro.slots.render("default")).trim()
  : "";
---

<Layout
  title={`${team.name} | Duke AERO Liquid Propulsion`}
  description={team.detail}
>
  <Header />

  <main class="relative bg-night">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <Embers
        class="absolute inset-x-0 top-0 h-110 w-full opacity-70 mask-[linear-gradient(to_bottom,black_50%,transparent)]"
        count={110}
        seed={Number(team.index)}
      />
    </div>

    <div
      class="relative z-10 mx-auto max-w-7xl px-6 pt-32 pb-24 md:px-12 md:pt-40 md:pb-32"
    >
      <a
        href="/#about"
        class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-white/60 transition-colors hover:text-white"
      >
        <ArrowLeft
          class="size-3.5 transition-transform group-hover:-translate-x-1"
          aria-hidden="true"
        />
        All subteams
      </a>

      <div class="mt-10 max-w-3xl">
        <p class="font-mono text-xs text-accent-peach">{team.index}</p>
        <h1
          class="text-gradient-metal mt-3 font-display text-[clamp(34px,5.4vw,64px)] font-bold leading-[0.95] tracking-[-0.02em]"
        >
          {team.name}
        </h1>
        <p
          class="mt-6 text-pretty text-base leading-relaxed text-steel-light md:text-lg"
        >
          {team.detail}
        </p>
      </div>

      <!-- The plate is the subject here rather than a texture, so it gets a
           lighter grade, no crop, and a caption instead of a scrim. Capped to
           a viewport-relative height rather than left at w-full h-auto: a
           near-square plate at full column width would otherwise render taller
           than the viewport on first scroll. Optional — see `plate` in
           data/subteams.ts for when a page is better off without one. -->
      {
        team.plate && (
          <figure class="mt-14 md:mt-20">
            <div class="flex justify-center border border-white/10 bg-white/[0.02] p-3 md:p-6">
              <Image
                src={team.plate}
                alt={team.plateAlt ?? ""}
                widths={[700, 1100, team.plate.width]}
                sizes="(min-width: 768px) 80vw, 100vw"
                class="h-auto max-h-[64vh] w-auto max-w-full"
                loading="eager"
              />
            </div>
            {team.plateCaption && (
              <figcaption class="mt-4 max-w-3xl text-sm leading-relaxed text-white/60">
                {team.plateCaption}
              </figcaption>
            )}
          </figure>
        )
      }

      {
        team.specs?.length && (
          <dl class="mx-auto mt-14 grid max-w-5xl gap-x-10 gap-y-6 border-t border-white/10 pt-10 sm:grid-cols-3 md:mt-20">
            {team.specs.map((spec) => (
              <div>
                <dt class="font-mono text-xs uppercase tracking-[0.18em] text-white/45">
                  {spec.label}
                </dt>
                <dd class="mt-2 font-display text-base font-bold text-white">
                  {spec.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        /* Two widths on purpose. The container is max-w-7xl for the plate's
           sake, and a line of body copy dragged that wide is unreadable — so
           the wrapper stops at the width the photo grids want, and
           `page-prose-wide` measures the text inside it. */
        prose && (
          <div class="mt-14 border-t border-white/10 pt-10 md:mt-20">
            <div class="page-prose page-prose-wide" set:html={prose} />
          </div>
        )
      }

      <nav class="mt-16 flex flex-wrap gap-3 border-t border-white/10 pt-10">
        {
          subteams
            .filter((other) => other.slug !== team.slug)
            .map((other) => (
              <a
                href={`/${other.slug}`}
                class="inline-flex items-center gap-3 border border-white/15 px-4 py-3 transition-colors hover:border-white/40"
              >
                <span class="font-mono text-xs text-accent-peach">
                  {other.index}
                </span>
                <span class="font-display text-sm font-bold text-white">
                  {other.name}
                </span>
              </a>
            ))
        }
      </nav>
    </div>
  </main>

  <Footer />
</Layout>
